import { connection, NextResponse } from "next/server";

const authorizedRef = "tfsdwfykhufmjtyvlgmn";

function isAuthorizedStagingUrl(value: string | undefined) {
  if (!value) return false;
  try {
    const url = new URL(value);
    return url.protocol === "https:"
      && url.hostname === `${authorizedRef}.supabase.co`
      && !url.port
      && url.pathname === "/"
      && !url.username
      && !url.password
      && !url.search
      && !url.hash;
  } catch {
    return false;
  }
}

export async function GET() {
  await connection();
  const configuredSupabaseUrls = Object.entries(process.env)
    .filter(([name]) => name === "SUPABASE_URL" || (/SUPABASE.*URL$/u.test(name) && name !== "SUPABASE_DB_URL"))
    .map(([, value]) => value);
  const verified = isAuthorizedStagingUrl(process.env.SUPABASE_URL)
    && isAuthorizedStagingUrl(process.env.NEXT_PUBLIC_SUPABASE_URL)
    && configuredSupabaseUrls.every(isAuthorizedStagingUrl);

  return NextResponse.json(
    { verified },
    {
      status: verified ? 200 : 503,
      headers: { "Cache-Control": "no-store" },
    },
  );
}

# Local example values only. Replace with authorized staging values before any live use.
# Do not commit actual credentials or personal secrets.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_AUTHORIZED_STAGING_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_AUTHORIZED_STAGING_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://staging.example.com

DISCOVERY_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ONLY_STAGING_ADMIN_PASSWORD
DISCOVERY_SESSION_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
# REQUIRED for admin login (RFC 6238 TOTP secret, base32, at least 16 decoded bytes).
# Enroll this secret in the Owner authenticator via your secure out-of-band setup.
DISCOVERY_ADMIN_TOTP_SECRET=

RESEND_API_KEY=
DISCOVERY_NOTIFICATION_TO=
DISCOVERY_NOTIFICATION_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Calendly booking page; requests are still not confirmed bookings.
NEXT_PUBLIC_CALENDLY_URL=

# Roadmap Phase 2: HMAC-signed links; use a separate random secret, 32+ characters.
LEAD_LINK_SECRET=
# Roadmap Phase 4: Vercel Cron bearer secret, random 32+ characters.
CRON_SECRET=
# Optional dedicated reply-from address; defaults to discovery sender.
INQUIRY_REPLY_FROM=

# Official RapidlyOn social profile URLs (https://). Leave blank until confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_DRIBBBLE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_BEHANCE_URL=

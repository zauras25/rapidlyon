# RapidlyOn staging Playwright QA configuration
# Template only. Do not store real passwords in Git.

STAGING_SITE_URL=

STAGING_CLIENT_A_EMAIL=
STAGING_CLIENT_A_PASSWORD=
STAGING_CLIENT_A_RECORDS_JSON=

STAGING_CLIENT_B_EMAIL=
STAGING_CLIENT_B_PASSWORD=
STAGING_CLIENT_B_RECORDS_JSON=

# Explicit approval flags: disabled by default
RAPIDLYON_STAGING_QA_APPROVED=false
RAPIDLYON_STAGING_E2E_APPROVED=false

# Potentially mutating/external actions remain disabled
RAPIDLYON_STAGING_COMMERCIAL_WRITE_APPROVED=false
RAPIDLYON_STAGING_EXTERNAL_EMAIL_APPROVED=false
RAPIDLYON_STAGING_DISCOVERY_WRITE_APPROVED=false